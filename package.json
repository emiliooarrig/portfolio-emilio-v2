{
  "name": "portfolio-emilio-v2",
  "version": "0.1.0",
  "private": true,
  "description": "Portafolio personal — Ingeniero de TI / Ingeniería de Datos. PHP MVC + SCSS.",
  "scripts": {
    "css": "sass public/assets/css/main.scss public/assets/css/main.css --style=expanded --no-source-map",
    "css:watch": "sass --watch public/assets/css/main.scss public/assets/css/main.css --style=expanded --no-source-map",
    "css:build": "sass public/assets/css/main.scss public/assets/css/main.css --style=compressed --no-source-map",
    "serve": "php -S localhost:8000 -t public"
  },
  "devDependencies": {
    "sass": "^1.77.0"
  }
}
